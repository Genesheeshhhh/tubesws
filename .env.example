APP_NAME="Mobil Bekas Medan"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL dipertahankan untuk data lama; katalog mobil dibaca dari Fuseki.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tubesws
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Apache Jena Fuseki (web semantik)
# ---------------------------------------------------------------------------
FUSEKI_URL=http://127.0.0.1:3030
FUSEKI_DATASET=TUBESWS
FUSEKI_TIMEOUT=30
FUSEKI_CACHE_TTL=300
FUSEKI_ONTOLOGY=mobil-bekas-medan-owl.xml
FUSEKI_ONTOLOGY_URL=http://www.semanticweb.org/mobil-bekas-medan
FUSEKI_NAMESPACE="http://www.semanticweb.org/mobil-bekas-medan#"

# Konsol SPARQL: hanya kunci lokal|wikidata|dbpedia yang diterima
SPARQL_DEFAULT_ENDPOINT=lokal
WIKIDATA_SPARQL_URL=https://query.wikidata.org/sparql
DBPEDIA_SPARQL_URL=https://dbpedia.org/sparql

# Asisten katalog hybrid (opsional). Tanpa API key, chatbot tetap offline.
# Jangan commit API key ke repository.
CHATBOT_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_TIMEOUT=12
GEMINI_CACHE_TTL=300

# ---------------------------------------------------------------------------
# Layanan eksternal (tanpa API key)
# ---------------------------------------------------------------------------
WHATSAPP_NUMBER=085277027100
MAP_FALLBACK_LAT=3.5952
MAP_FALLBACK_LNG=98.6722
MAP_ZOOM=12
MAP_SEARCH_SUFFIX=", Sumatera Utara, Indonesia"

